# En production : https://compleo.work
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants de prix Stripe (price_...) des trois offres
STRIPE_PACK_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Fournisseur IA : openai-compatible (modèles open source, défaut) | openai | anthropic
AI_PROVIDER=openai-compatible
# Ollama local : http://localhost:11434/v1 (AI_API_KEY inutile)
# Groq : https://api.groq.com/openai/v1 | OpenRouter : https://openrouter.ai/api/v1
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.1:8b
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# E-mail (Resend). EMAIL_FROM doit utiliser un domaine vérifié dans Resend, ex. "Compléo <contact@compleo.work>"
RESEND_API_KEY=
EMAIL_FROM=
# Secret du cron quotidien (Vercel l'envoie en Authorization: Bearer) et des liens de désinscription
CRON_SECRET=
# Optionnel : secret dédié aux liens de désinscription (par défaut CRON_SECRET)
EMAIL_UNSUBSCRIBE_SECRET=

# Newsletter du blog (double opt-in). "true" affiche le formulaire et ouvre /api/newsletter/subscribe ; à activer seulement après
# relecture juridique du consentement et de la politique de confidentialité, et avec RESEND_API_KEY, EMAIL_FROM et un secret de
# désinscription (CRON_SECRET ou EMAIL_UNSUBSCRIBE_SECRET). Valeur lue au build : redéployer après changement. Migration 0010.
NEWSLETTER_ENABLED=

# Script scripts/fetch-unsplash-images.py uniquement (sélection des photos Unsplash : villes et site). Inutile au site.
UNSPLASH_ACCESS_KEY=

# Preuve sociale (optionnel). SOCIAL_PROOF_SINCE = jour d'ouverture au public (AAAA-MM-JJ) : sans cette date, aucun compteur
# d'annonces n'est affiché. SOCIAL_PROOF_MIN_LISTINGS = seuil d'affichage (100 par défaut).
SOCIAL_PROOF_SINCE=
SOCIAL_PROOF_MIN_LISTINGS=
